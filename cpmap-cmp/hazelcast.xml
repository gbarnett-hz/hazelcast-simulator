<?xml version="1.0" encoding="UTF-8"?>
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
           http://www.hazelcast.com/schema/config/hazelcast-config-5.0.xsd">

    <cluster-name>workers</cluster-name>

    <!--LITE_MEMBER_CONFIG-->

    <network>
        <port port-count="200">5701</port>

        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="true">
                <!--MEMBERS-->
            </tcp-ip>
        </join>
    </network>

    <properties>
        <property name="hazelcast.phone.home.enabled">false</property>
        <property name="hazelcast.logging.type">log4j2</property>
    </properties>

    <cp-subsystem>
        <cp-member-count>9</cp-member-count>
        <group-size>3</group-size>
        <raft-algorithm>
            <!--
                Default is 10000. At this workload's steady-state per-group commit rate
                (~2,850 ops/s across 31 partitioned CP groups), the default triggers a
                chunked CPMap snapshot roughly every 3.5s per group leader, which JFR
                allocation profiling showed dominates allocation (~68% of sampled bytes
                during steady-state, see analysis/findings.md) via unsized ArrayList
                growth in KeyValueDataChunk.addToChunk. Raised 20x here to ~70s between
                snapshots per group, to see whether the heap sawtooth/Evacuation Failure
                frequency drops in direct proportion.
            -->
            <commit-index-advance-count-to-snapshot>200000</commit-index-advance-count-to-snapshot>
      <!--<commit-index-advance-count-to-snapshot>100000</commit-index-advance-count-to-snapshot>-->
        </raft-algorithm>
        <maps>
            <!--
                CPMapConfig lookup is keyed on the "base name" only (everything before the '@'
                in a CPMap's underlying name, per StringPartitioningStrategy.getBaseName / CPSubsystemConfig
                .findCPMapConfig). CPMapPartitioned shards are all named name@name-group-i, so a single entry
                here, keyed by the test's plain name, applies independently to every one of that test's
                constituent CPMap shards: one entry per test name, not one per shard.
            -->
            <map>
                <name>full_load</name>
                <max-size-mb>1800</max-size-mb>
            </map>
        </maps>
    </cp-subsystem>

    <!--LICENSE-KEY-->

</hazelcast>

